# RaktMap Backend Environment Variables
# Copy this file to .env and fill in your actual values

# ======================
# Security Configuration
# ======================
JWT_SECRET=your_very_strong_secret_key_min_32_characters_long_change_this_in_production
JWT_EXPIRE=24h
NODE_ENV=development

# ======================
# Database Configuration
# ======================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/raktmap?retryWrites=true&w=majority

# ======================
# Email Service (Nodemailer)
# ======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@raktmap.com

# ======================
# SMS Service (Twilio)
# ======================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ======================
# Server Configuration
# ======================
PORT=3000
FRONTEND_URL=http://localhost:5173
MOBILE_APP_URL=exp://localhost:8081

# ======================
# Security Options
# ======================
# Rate limiting (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
SMS_RATE_LIMIT_MAX=10

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Session configuration
SESSION_SECRET=another_very_strong_secret_for_sessions_change_this

# ======================
# Feature Flags
# ======================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_LOCATION_TRACKING=true
REQUIRE_EMAIL_VERIFICATION=true

# ======================
# Development/Debug
# ======================
DEBUG=false
LOG_LEVEL=info
