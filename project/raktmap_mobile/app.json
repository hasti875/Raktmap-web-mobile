{
  "expo": {
    "name": "Raktmap",
    "slug": "raktmap-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8102E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raktmap.blooddonation"
    },
    "android": {
      "package": "com.raktmap.blooddonation",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8102E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ACTUAL_GOOGLE_MAPS_KEY" 
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",           
        {
          "cameraPermission": "Allow Raktmap to access camera for QR scanning."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Raktmap to use your location to find nearby donors."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",  
          "color": "#C8102E"
          
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "4606980c-73e9-4cb5-b9cd-71ce761d2c37"
      }
    }
  }
}
